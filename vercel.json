{
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/daily-score",
      "schedule": "5 0 * * *"
    },
    {
      "path": "/api/cron/duo-notifications",
      "schedule": "10 0 * * *"
    },
    {
      "path": "/api/cron/challenge-streaks",
      "schedule": "15 0 * * *"
    }
  ]
}
