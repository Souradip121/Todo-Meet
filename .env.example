# ── Database (Neon) ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host.neon.tech/dbname?sslmode=require

# ── Auth (better-auth) ────────────────────────────────────────────────────
BETTER_AUTH_SECRET=your_32_byte_random_secret_here
BETTER_AUTH_URL=https://showup.day

# ── LinkedIn OAuth ────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Pusher ────────────────────────────────────────────────────────────────
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# ── Cron (Vercel Cron auth header) ────────────────────────────────────────
CRON_SECRET=

# ── Email (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY=
